<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_robot">

    <xacro:include filename="$(find robot_bringup)/urdf/robot_properties.xacro"/>
    <xacro:include filename="$(find robot_bringup)/urdf/my_robot_links.xacro"/>
    <xacro:include filename="$(find robot_bringup)/urdf/my_robot_joints.xacro"/>
    <xacro:include filename="$(find robot_bringup)/urdf/ros2_control.xacro"/>
    <xacro:include filename="$(find robot_bringup)/urdf/lidar.xacro"/>
    <xacro:include filename="$(find robot_bringup)/urdf/imu.xacro"/>

    <xacro:lidar parent_link="base_link" x_loc="0.0" y_loc="0.0" z_loc="0.15"/>

</robot>
